        @"Time Range" : @"\u65f6\u95f4\u6bb5",
        @"End Repeat" : @"\u7ed3\u675f\u91cd\u590d",
        @"End If" : @"\u7ed3\u675f\u5982\u679c",
        @"Conditional Block" : @"\u6761\u4ef6\u4ee3\u7801\u5757",
        @"Unknown Action" : @"\u672a\u77e5\u52a8\u4f5c",

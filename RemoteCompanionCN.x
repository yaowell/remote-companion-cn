        @"Power + Volume Up" : @"\u7535\u6e90+\u97f3\u91cf\u52a0",
        @"Power + Volume Down" : @"\u7535\u6e90+\u97f3\u91cf\u51cf",
        @"Status Bar Left Hold" : @"\u72b6\u6001\u680f\u5de6\u4fa7\u957f\u6309",
        @"Status Bar Center Hold" : @"\u72b6\u6001\u680f\u4e2d\u90e8\u957f\u6309",
        @"Status Bar Right Hold" : @"\u72b6\u6001\u680f\u53f3\u4fa7\u957f\u6309",
        @"Status Bar Swipe Left" : @"\u72b6\u6001\u680f\u5de6\u6ed1",

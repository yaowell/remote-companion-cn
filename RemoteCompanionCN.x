        @"Volume Down Hold" : @"\u97f3\u91cf\u51cf\u957f\u6309",
        @"Volume Up + Down (Both)" : @"\u97f3\u91cf\u52a0+\u51cf\uff08\u540c\u65f6\uff09",
        @"Volume Up then Down" : @"\u97f3\u91cf\u52a0\u540e\u51cf",

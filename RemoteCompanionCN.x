        @"Wait Until..." : @"\u7b49\u5f85\u76f4\u5230\u2026",
        @"Set Variable..." : @"\u8bbe\u7f6e\u53d8\u91cf\u2026",
        @"Stop Trigger..." : @"\u505c\u6b62\u89e6\u53d1\u5668\u2026",
        @"Terminal Command" : @"\u7ec8\u7aef\u547d\u4ee4",
        @"Toast..." : @"\u5f39\u51fa\u63d0\u793a\u2026",
        @"Search Results" : @"\u641c\u7d22\u7ed3\u679c",
        @"Set Volume" : @"\u8bbe\u7f6e\u97f3\u91cf",
        @"Set Ringer Volume" : @"\u8bbe\u7f6e\u54cd\u94c3\u97f3\u91cf",
        @"Set Brightness" : @"\u8bbe\u7f6e\u4eae\u5ea6",
        @"Set Flashlight" : @"\u8bbe\u7f6e\u624b\u7535\u7b52",
        @"Unlock Device" : @"\u89e3\u9501\u8bbe\u5907",
        @"Ask for Passcode" : @"\u8be2\u95ee\u5bc6\u7801",
        @"Lock Toggle" : @"\u9501\u5b9a\u5f00\u5173",
        @"Unlocks automatically with the device passcode, kept in the Keychain on this iPhone only." : @"\u7528\u8bbe\u5907\u5bc6\u7801\u81ea\u52a8\u89e3\u9501\u3002\u5bc6\u7801\u53ea\u4fdd\u5b58\u5728\u672c\u673a\u7684\u94a5\u5319\u4e32\u4e2d\u3002",
        @"Enter the device passcode." : @"\u8f93\u5165\u8bbe\u5907\u5bc6\u7801\u3002",
        @"Connect AirPlay" : @"\u8fde\u63a5 AirPlay",
        @"Connect Bluetooth" : @"\u8fde\u63a5\u84dd\u7259",
        @"Disconnect Bluetooth" : @"\u65ad\u5f00\u84dd\u7259",
        @"You must add at least one SSH host before creating an SSH action.\\nGo to Settings > Integrations > SSH Hosts." : @"\u521b\u5efa SSH \u52a8\u4f5c\u524d\u9700\u5148\u6dfb\u52a0\u81f3\u5c11\u4e00\u53f0 SSH \u4e3b\u673a\u3002\\n\u524d\u5f80 \u8bbe\u7f6e > \u96c6\u6210 > SSH \u4e3b\u673a\u3002",
        @"Choose a target host for this remote command" : @"\u4e3a\u8fd9\u6761\u8fdc\u7a0b\u547d\u4ee4\u9009\u62e9\u76ee\u6807\u4e3b\u673a",
        @"Asks for more" : @"\u7ee7\u7eed\u8be2\u95ee",
        @"Triggers per Row" : @"\u6bcf\u884c\u89e6\u53d1\u5668\u6570",
        @"Compact Sections" : @"\u7d27\u51d1\u5206\u533a",
        @"Category Bar Lines" : @"\u5206\u7c7b\u680f\u884c\u6570",
        @"Deselect All" : @"\u53d6\u6d88\u5168\u9009",
        @"New Toast" : @"\u65b0\u5efa\u63d0\u793a",
        @"Edit Toast" : @"\u7f16\u8f91\u63d0\u793a",
        @"Insert Variable" : @"\u63d2\u5165\u53d8\u91cf",
        @"Shows as a popup on this device." : @"\u5728\u672c\u673a\u663e\u793a\u4e3a\u5f39\u7a97\u3002",
        @"Loading registered app shortcuts..." : @"\u6b63\u5728\u52a0\u8f7d\u5df2\u6ce8\u518c\u7684\u5e94\u7528\u5feb\u6377\u65b9\u5f0f\u2026",
        @"Unable to load native app shortcuts. Check the SpringBoard connection and retry." : @"\u65e0\u6cd5\u52a0\u8f7d\u539f\u751f\u5e94\u7528\u5feb\u6377\u65b9\u5f0f\u3002\u8bf7\u68c0\u67e5 SpringBoard \u8fde\u63a5\u540e\u91cd\u8bd5\u3002",
        @"Native app shortcuts are unavailable on this device." : @"\u672c\u8bbe\u5907\u4e0d\u652f\u6301\u539f\u751f\u5e94\u7528\u5feb\u6377\u65b9\u5f0f\u3002",
        @"Choose a registered app shortcut. Its current native payload is resolved again when the action runs." : @"\u9009\u62e9\u4e00\u4e2a\u5df2\u6ce8\u518c\u7684\u5e94\u7528\u5feb\u6377\u65b9\u5f0f\u3002\u8fd0\u884c\u65f6\u4f1a\u91cd\u65b0\u89e3\u6790\u5176\u539f\u751f\u8d1f\u8f7d\u3002",
        @"This app currently has no registered Quick Shortcuts. Apps may register dynamic shortcuts after being opened. Open the app, then refresh here." : @"\u8be5\u5e94\u7528\u76ee\u524d\u6ca1\u6709\u6ce8\u518c\u7684\u5feb\u6377\u65b9\u5f0f\u3002\u5e94\u7528\u6253\u5f00\u540e\u53ef\u80fd\u4f1a\u6ce8\u518c\u52a8\u6001\u5feb\u6377\u65b9\u5f0f\uff0c\u5148\u6253\u5f00\u5e94\u7528\u518d\u56de\u6765\u5237\u65b0\u3002",
        @"AirPlay Connect" : @"AirPlay \u8fde\u63a5",
        @"Turn On" : @"\u6253\u5f00",
        @"(Saved Passcode)" : @"\uff08\u5df2\u4fdd\u5b58\u5bc6\u7801\uff09",
        @"Choose what happens if this trigger fires while its actions are still running." : @"\u9009\u62e9\u89e6\u53d1\u5668\u5728\u52a8\u4f5c\u4ecd\u5728\u8fd0\u884c\u65f6\u518d\u6b21\u89e6\u53d1\u65f6\u7684\u5904\u7406\u65b9\u5f0f\u3002",
        @"Run Alongside" : @"\u5e76\u884c\u8fd0\u884c",
        @"Stops that trigger's actions while they're still running, such as during a delay." : @"\u505c\u6b62\u8be5\u89e6\u53d1\u5668\u4ecd\u5728\u8fd0\u884c\u7684\u52a8\u4f5c\uff08\u5305\u62ec\u5ef6\u8fdf\u7b49\u5f85\u4e2d\uff09\u3002",
        @"No Name" : @"\u672a\u547d\u540d",
        @"Enter terminal command" : @"\u8f93\u5165\u7ec8\u7aef\u547d\u4ee4",
        @"Connect to Bluetooth" : @"\u8fde\u63a5\u84dd\u7259",
        @"Lua Script" : @"Lua \u811a\u672c",
        @"Enter Lua code to execute" : @"\u8f93\u5165\u8981\u6267\u884c\u7684 Lua \u4ee3\u7801",
        @"Always Play" : @"\u59cb\u7ec8\u64ad\u653e",
        @"Play in Silent Mode" : @"\u9759\u97f3\u6a21\u5f0f\u4e0b\u64ad\u653e",
        @"Don't Play in Silent Mode" : @"\u9759\u97f3\u6a21\u5f0f\u4e0b\u4e0d\u64ad\u653e",
        @"Never Play" : @"\u4ece\u4e0d\u64ad\u653e",
        @"Time of Day (Between)" : @"\u4e00\u5929\u4e2d\u7684\u65f6\u6bb5\uff08\u4ecb\u4e8e\uff09",
        @"Day of the Week" : @"\u661f\u671f\u51e0",
        @"Lock Status" : @"\u9501\u5b9a\u72b6\u6001",
        @"Player Status" : @"\u64ad\u653e\u5668\u72b6\u6001",
        @"Wi-Fi Network" : @"Wi-Fi \u7f51\u7edc",
        @"Bluetooth Device Connected" : @"\u84dd\u7259\u8bbe\u5907\u5df2\u8fde\u63a5",
        @"Not Connected" : @"\u672a\u8fde\u63a5",
        @"Ringer Switch" : @"\u54cd\u94c3\u5f00\u5173",
        @"Not Recording" : @"\u672a\u5728\u5f55\u5236",
        @"Not Charging" : @"\u672a\u5728\u5145\u7535",
        @"Battery Level" : @"\u7535\u6c60\u7535\u91cf",
        @"Volume Level" : @"\u97f3\u91cf\u5927\u5c0f",
        @"Front Application" : @"\u524d\u53f0\u5e94\u7528",
        @"Proximity Sensor" : @"\u8ddd\u79bb\u4f20\u611f\u5668",
        @"Matches the exact name (case doesn't matter)." : @"\u540d\u79f0\u9700\u5b8c\u5168\u4e00\u81f4\uff08\u4e0d\u533a\u5206\u5927\u5c0f\u5199\uff09\u3002",
        @"True when the level is above or below this percentage." : @"\u7535\u91cf\u9ad8\u4e8e\u6216\u4f4e\u4e8e\u6b64\u767e\u5206\u6bd4\u65f6\u6210\u7acb\u3002",
        @"Time of Day" : @"\u65f6\u6bb5",
        @"Else If Condition" : @"\u5426\u5219\u5982\u679c\u6761\u4ef6",
        @"Repeat While" : @"\u5f53\u2026\u91cd\u590d",
        @"Wait Until" : @"\u7b49\u5f85\u76f4\u5230",
        @"If Condition" : @"\u5982\u679c\u6761\u4ef6",
        @"The longest to wait, up to a day. Then the actions go on anyway." : @"\u6700\u957f\u7b49\u5f85\u65f6\u95f4\uff08\u81f3\u591a\u4e00\u5929\uff09\u3002\u8d85\u65f6\u540e\u52a8\u4f5c\u7ee7\u7eed\u6267\u884c\u3002",
        @"Ringer Volume" : @"\u54cd\u94c3\u97f3\u91cf",
        @"The media volume to set, from 0 to 100." : @"\u8981\u8bbe\u7f6e\u7684\u5a92\u4f53\u97f3\u91cf\uff0c0 \u5230 100\u3002",
        @"The ringer and alerts volume to set, from 0 to 100." : @"\u8981\u8bbe\u7f6e\u7684\u54cd\u94c3\u4e0e\u63d0\u9192\u97f3\u91cf\uff0c0 \u5230 100\u3002",
        @"The screen brightness to set, from 0 to 100." : @"\u8981\u8bbe\u7f6e\u7684\u5c4f\u5e55\u4eae\u5ea6\uff0c0 \u5230 100\u3002",
        @"How long to wait before the next action, up to a day." : @"\u7b49\u5f85\u591a\u4e45\u518d\u6267\u884c\u4e0b\u4e00\u4e2a\u52a8\u4f5c\uff0c\u81f3\u591a\u4e00\u5929\u3002",
        @"Runs the actions inside this many times, up to 1,000. In their text, {round} becomes the current round." : @"\u5c06\u5185\u90e8\u52a8\u4f5c\u91cd\u590d\u6267\u884c\u6307\u5b9a\u6b21\u6570\uff08\u81f3\u591a 1000 \u6b21\uff09\u3002\u52a8\u4f5c\u6587\u672c\u4e2d {round} \u4f1a\u66ff\u6362\u4e3a\u5f53\u524d\u8f6e\u6b21\u3002",
        @"Enable Action" : @"\u542f\u7528\u52a8\u4f5c",
        @"Disable Action" : @"\u505c\u7528\u52a8\u4f5c",
        @"Edit Command" : @"\u7f16\u8f91\u547d\u4ee4",
        @"Update your terminal command" : @"\u4fee\u6539\u7ec8\u7aef\u547d\u4ee4",
        @"Edit Lua Script" : @"\u7f16\u8f91 Lua \u811a\u672c",
        @"Update your Lua code" : @"\u4fee\u6539 Lua \u4ee3\u7801",
        @"Add a server in Settings > Integrations > SSH Hosts first." : @"\u8bf7\u5148\u5728 \u8bbe\u7f6e > \u96c6\u6210 > SSH \u4e3b\u673a \u4e2d\u6dfb\u52a0\u670d\u52a1\u5668\u3002",
        @"Edit Unlock Action" : @"\u7f16\u8f91\u89e3\u9501\u52a8\u4f5c",
        @"Edit Lock Toggle Action" : @"\u7f16\u8f91\u9501\u5b9a\u5f00\u5173\u52a8\u4f5c",
        @"AirPlay Device" : @"AirPlay \u8bbe\u5907",
        @"If triggered again while running, this sequence will start over." : @"\u8fd0\u884c\u4e2d\u518d\u6b21\u89e6\u53d1\u65f6\uff0c\u4ece\u5934\u91cd\u65b0\u5f00\u59cb\u6267\u884c\u3002",
        @"If triggered again while running, the new trigger will be ignored." : @"\u8fd0\u884c\u4e2d\u518d\u6b21\u89e6\u53d1\u65f6\uff0c\u5ffd\u7565\u65b0\u7684\u89e6\u53d1\u3002",
        @"If triggered again while running, another run will start alongside." : @"\u8fd0\u884c\u4e2d\u518d\u6b21\u89e6\u53d1\u65f6\uff0c\u53e6\u8d77\u4e00\u6b21\u5e76\u884c\u8fd0\u884c\u3002",
        @"Changes what happens when triggered again" : @"\u66f4\u6539\u518d\u6b21\u89e6\u53d1\u65f6\u7684\u884c\u4e3a",
        @"Remote Host" : @"\u8fdc\u7a0b\u4e3b\u673a",
        @"Siri Shortcut" : @"Siri \u5feb\u6377\u6307\u4ee4",
        @"Kill Application" : @"\u6740\u6389\u5e94\u7528",
        @"This block contains 1 action." : @"\u6b64\u4ee3\u7801\u5757\u5305\u542b 1 \u4e2a\u52a8\u4f5c\u3002",
        @"Actions that show a banner when a trigger runs them. A banner that comes while the screen is off waits until it turns on, unless Wake Screen is on." : @"\u89e6\u53d1\u5668\u8fd0\u884c\u8fd9\u4e9b\u52a8\u4f5c\u65f6\u663e\u793a\u6a2a\u5e45\u3002\u606f\u5c4f\u65f6\u5230\u6765\u7684\u6a2a\u5e45\u4f1a\u7b49\u5c4f\u5e55\u70b9\u4eae\u540e\u518d\u663e\u793a\uff0c\u9664\u975e\u5f00\u542f\u4e86\u70b9\u4eae\u5c4f\u5e55\u3002",
        @"Experimental NFC requires iPhone XS or later." : @"\u5b9e\u9a8c\u6027 NFC \u9700\u8981 iPhone XS \u6216\u66f4\u65b0\u673a\u578b\u3002",
        @"Enabling Experimental NFC gives control of the NFC sensor back to iOS. This is so that express cards, tags, and passes still work as intended. iOS has an internal NFC cooldown of about 3 seconds. For cards and keys to work while the phone is locked, keep NFC With Screen Off set to Off." : @"\u5f00\u542f\u5b9e\u9a8c\u6027 NFC \u4f1a\u5c06 NFC \u4f20\u611f\u5668\u63a7\u5236\u6743\u4ea4\u8fd8 iOS\uff0c\u4ee5\u786e\u4fdd\u4ea4\u901a\u5361\u3001\u6807\u7b7e\u548c\u95e8\u7981\u5361\u6b63\u5e38\u5de5\u4f5c\u3002iOS \u5185\u90e8\u6709\u7ea6 3 \u79d2\u7684 NFC \u51b7\u5374\u65f6\u95f4\u3002\u82e5\u8981\u5728\u9501\u5c4f\u65f6\u4f7f\u7528\u5361\u7247\u548c\u94a5\u5319\uff0c\u8bf7\u4fdd\u6301\u606f\u5c4f NFC \u4e3a\u5173\u95ed\u3002",
        @"Compact shows a grid of tiles instead of a list. Triggers per Row applies to Triggers in Compact." : @"\u7d27\u51d1\u6a21\u5f0f\u4ee5\u78c1\u8d34\u7f51\u683c\u4ee3\u66ff\u5217\u8868\u3002\u6bcf\u884c\u89e6\u53d1\u5668\u6570\u5728\u7d27\u51d1\u6a21\u5f0f\u4e0b\u4f5c\u7528\u4e8e\u89e6\u53d1\u5668\u9875\u3002",
        @"How long a press waits for the next one before it counts. A shorter time responds sooner and needs quicker presses." : @"\u4e00\u6b21\u6309\u538b\u7b49\u5f85\u4e0b\u4e00\u6b21\u6309\u538b\u7684\u6700\u957f\u65f6\u95f4\u3002\u65f6\u95f4\u8d8a\u77ed\u54cd\u5e94\u8d8a\u5feb\uff0c\u4f46\u9700\u8981\u66f4\u5feb\u8fde\u6309\u3002",
        @"Lets scripts, terminals and other tools call the root helper directly. Any app on this device can then get root, so leave it off unless you need it." : @"\u5141\u8bb8\u811a\u672c\u3001\u7ec8\u7aef\u7b49\u5de5\u5177\u76f4\u63a5\u8c03\u7528 Root \u52a9\u624b\u3002\u6b64\u540e\u672c\u673a\u4efb\u4f55\u5e94\u7528\u90fd\u53ef\u83b7\u5f97 root \u6743\u9650\uff0c\u9664\u975e\u786e\u6709\u9700\u8981\u5426\u5219\u8bf7\u52ff\u5f00\u542f\u3002",
        @"Volume Sequence" : @"\u97f3\u91cf\u5e8f\u5217",
        @"How soon after a volume press the other volume button completes an Up then Down or Down then Up sequence." : @"\u6309\u4e0b\u4e00\u4e2a\u97f3\u91cf\u952e\u540e\uff0c\u518d\u6309\u53e6\u4e00\u4e2a\u952e\u591a\u5c11\u79d2\u5185\u7b97\u4f5c\u300c\u52a0\u540e\u51cf\u300d\u6216\u300c\u51cf\u540e\u52a0\u300d\u5e8f\u5217\u3002",
        @"Power Clicks" : @"\u7535\u6e90\u8fde\u6309",
        @"How long a Power press waits for the next click before the clicks count as a double, triple or quadruple click." : @"\u7535\u6e90\u952e\u8fde\u6309\u7684\u95f4\u9694\u4e0a\u9650\uff0c\u8d85\u8fc7\u5219\u4e0d\u7b97\u53cc\u51fb/\u4e09\u51fb/\u56db\u51fb\u3002",
        @"Home Clicks" : @"\u4e3b\u5c4f\u5e55\u8fde\u6309",
        @"How long a Home press waits for the next click before the clicks count as a double, triple or quadruple click." : @"\u4e3b\u5c4f\u5e55\u952e\u8fde\u6309\u7684\u95f4\u9694\u4e0a\u9650\uff0c\u8d85\u8fc7\u5219\u4e0d\u7b97\u53cc\u51fb/\u4e09\u51fb/\u56db\u51fb\u3002",
        @"Volume Hold" : @"\u97f3\u91cf\u957f\u6309",
        @"How long a Volume Up or Down press is held before it counts as a hold rather than a tap. Taps wait this long when a hold trigger is set." : @"\u97f3\u91cf\u952e\u6309\u4f4f\u591a\u4e45\u7b97\u957f\u6309\u800c\u975e\u70b9\u6309\u3002\u8bbe\u7f6e\u4e86\u957f\u6309\u89e6\u53d1\u5668\u65f6\uff0c\u70b9\u6309\u4e5f\u9700\u7b49\u5f85\u6b64\u65f6\u957f\u3002",
        @"Power Hold" : @"\u7535\u6e90\u957f\u6309",
        @"How long a Power press is held before it counts as a long press." : @"\u7535\u6e90\u952e\u6309\u4f4f\u591a\u4e45\u7b97\u957f\u6309\u3002",
        @"Minimal records triggers, their actions and conditions, and errors. Full records every step, for tracking down a problem." : @"\u6700\u5c0f\u6a21\u5f0f\u8bb0\u5f55\u89e6\u53d1\u5668\u3001\u52a8\u4f5c\u3001\u6761\u4ef6\u4e0e\u9519\u8bef\u3002\u5b8c\u6574\u6a21\u5f0f\u8bb0\u5f55\u6bcf\u4e00\u6b65\uff0c\u7528\u4e8e\u6392\u67e5\u95ee\u9898\u3002",
        @"How long a tag can still be tapped after the screen turns off. Off reads tags only while the screen is on." : @"\u606f\u5c4f\u540e\u6807\u7b7e\u4ecd\u53ef\u5237\u53d6\u7684\u65f6\u957f\u3002\u5173\u95ed\u5219\u4ec5\u5728\u4eae\u5c4f\u65f6\u53ef\u8bfb\u3002",
        @"The NFC reader stays in use while the screen is off. That costs battery (about 3% an hour on an iPhone 8) and warms the phone, and the system may switch the reader off for a few minutes. A longer window only helps when tags are tapped long after the screen goes dark." : @"\u606f\u5c4f\u671f\u95f4 NFC \u8bfb\u53d6\u5668\u6301\u7eed\u5de5\u4f5c\uff0c\u4f1a\u589e\u52a0\u8017\u7535\uff08iPhone 8 \u7ea6\u6bcf\u5c0f\u65f6 3%\uff09\u5e76\u53d1\u70ed\uff0c\u7cfb\u7edf\u4e5f\u53ef\u80fd\u5c06\u5176\u5173\u95ed\u6570\u5206\u949f\u3002\u5ef6\u957f\u7a97\u53e3\u53ea\u5728\u606f\u5c4f\u5f88\u4e45\u540e\u624d\u5237\u6807\u7b7e\u65f6\u6709\u5e2e\u52a9\u3002",
        @"App launched! starting didFinishLaunchingWithOptions" : @"\u5e94\u7528\u5df2\u542f\u52a8\uff01\u8fdb\u5165 didFinishLaunchingWithOptions",
        @"Window created" : @"\u7a97\u53e3\u5df2\u521b\u5efa",
        @"Nav created" : @"\u5bfc\u822a\u5df2\u521b\u5efa",
        @"Select Apps" : @"\u9009\u62e9\u5e94\u7528",
        @"Edit Audio Output" : @"\u7f16\u8f91\u97f3\u9891\u8f93\u51fa",
        @"New Audio Output" : @"\u65b0\u5efa\u97f3\u9891\u8f93\u51fa",
        @"Trigger Event" : @"\u89e6\u53d1\u4e8b\u4ef6",
        @"Select Device" : @"\u9009\u62e9\u8bbe\u5907",
        @"Output Unset:" : @"\u8f93\u51fa\u5df2\u53d6\u6d88\uff1a",
        @"Output Set:" : @"\u8f93\u51fa\u5df2\u8bbe\u7f6e\uff1a",
        @"Checked actions show a banner whenever a trigger runs them. Toggles show their new state; other actions show their name." : @"\u52fe\u9009\u7684\u52a8\u4f5c\u5728\u89e6\u53d1\u5668\u8fd0\u884c\u65f6\u663e\u793a\u6a2a\u5e45\u3002\u5f00\u5173\u7c7b\u663e\u793a\u5207\u6362\u540e\u7684\u72b6\u6001\uff1b\u5176\u4ed6\u52a8\u4f5c\u663e\u793a\u540d\u79f0\u3002",
        @"Runs once each time the battery charges to this level." : @"\u6bcf\u6b21\u5145\u7535\u5230\u6b64\u7535\u91cf\u65f6\u8fd0\u884c\u4e00\u6b21\u3002",
        @"Runs once each time the battery drains to this level." : @"\u6bcf\u6b21\u6389\u7535\u5230\u6b64\u7535\u91cf\u65f6\u8fd0\u884c\u4e00\u6b21\u3002",
        @"Edit Bluetooth" : @"\u7f16\u8f91\u84dd\u7259",
        @"New Bluetooth" : @"\u65b0\u5efa\u84dd\u7259",
        @"Disconnected from" : @"\u5df2\u65ad\u5f00",
        @"Connected to" : @"\u5df2\u8fde\u63a5",
        @"Silent Vibrate" : @"\u9759\u97f3\u632f\u52a8",
        @"Lock State" : @"\u9501\u5b9a\u72b6\u6001",
        @"Levels are stored as a number, such as 85." : @"\u7535\u91cf\u4ee5\u6570\u5b57\u4fdd\u5b58\uff0c\u4f8b\u5982 85\u3002",
        @"Each row shows the answer this phone gives now; the variable stores the answer at run time." : @"\u6bcf\u884c\u663e\u793a\u672c\u673a\u5f53\u524d\u7684\u5e94\u7b54\u503c\uff1b\u53d8\u91cf\u5728\u8fd0\u884c\u65f6\u4fdd\u5b58\u5e94\u7b54\u503c\u3002",
        @"Every Day" : @"\u6bcf\u5929",
        @"Loading devices\u2026" : @"\u6b63\u5728\u52a0\u8f7d\u8bbe\u5907\u2026",
        @"Any Focus" : @"\u4efb\u610f\u4e13\u6ce8\u6a21\u5f0f",
        @"Set Time Range\u2026" : @"\u8bbe\u7f6e\u65f6\u95f4\u6bb5\u2026",
        @"Choose App\u2026" : @"\u9009\u62e9\u5e94\u7528\u2026",
        @"Enter Name\u2026" : @"\u8f93\u5165\u540d\u79f0\u2026",
        @"Set Level\u2026" : @"\u8bbe\u7f6e\u7535\u91cf\u2026",
        @"The tweak didn't answer. Is RemoteCompanion installed and SpringBoard resprung?" : @"\u63d2\u4ef6\u6ca1\u6709\u54cd\u5e94\u3002RemoteCompanion \u662f\u5426\u5df2\u5b89\u88c5\u5e76\u6ce8\u9500\u8fc7 SpringBoard\uff1f",
        @"Shake Device" : @"\u6447\u6643\u8bbe\u5907",
        @"Find My Sound" : @"\u67e5\u627e\u58f0\u97f3",
        @"CarPlay Connected" : @"CarPlay \u5df2\u8fde\u63a5",
        @"CarPlay Disconnected" : @"CarPlay \u5df2\u65ad\u5f00",
        @"Rotated to Landscape" : @"\u8f6c\u4e3a\u6a2a\u5c4f",
        @"Rotated to Portrait" : @"\u8f6c\u4e3a\u7ad6\u5c4f",
        @"Incoming Call" : @"\u6765\u7535",
        @"Call Started" : @"\u901a\u8bdd\u5f00\u59cb",
        @"Call Ended" : @"\u901a\u8bdd\u7ed3\u675f",

        @"Ringer Muted (Silent Mode On)" : @"\u54cd\u94c3\u5df2\u9759\u97f3\uff08\u9759\u97f3\u6a21\u5f0f\u5f00\uff09",
        @"Ringer Unmuted (Silent Mode Off)" : @"\u54cd\u94c3\u5df2\u53d6\u6d88\u9759\u97f3\uff08\u9759\u97f3\u6a21\u5f0f\u5173\uff09",

        @"Status Bar Double Tap" : @"\u72b6\u6001\u680f\u53cc\u51fb",
        @"2-Finger Top Slide Down" : @"\u53cc\u6307\u9876\u90e8\u4e0b\u6ed1",
        @"2-Finger Bottom Slide Up" : @"\u53cc\u6307\u5e95\u90e8\u4e0a\u6ed1",
        @"Home Button (Triple Click)" : @"\u4e3b\u5c4f\u5e55\u952e\uff08\u4e09\u51fb\uff09",
        @"Home Button (Quadruple Click)" : @"\u4e3b\u5c4f\u5e55\u952e\uff08\u56db\u51fb\uff09",
        @"Home Button (Hold)" : @"\u4e3b\u5c4f\u5e55\u952e\uff08\u957f\u6309\uff09",
        @"Home Button (Double Click)" : @"\u4e3b\u5c4f\u5e55\u952e\uff08\u53cc\u51fb\uff09",

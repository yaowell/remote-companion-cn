        @"Keyboard Maestro: Trigger Macro..." : @"Keyboard Maestro\uff1a\u89e6\u53d1\u5b8f\u2026",
        @"MQTT: Publish Topic..." : @"MQTT\uff1a\u53d1\u5e03\u4e3b\u9898\u2026",
        @"SSH: Run Remote Command..." : @"SSH\uff1a\u8fd0\u884c\u8fdc\u7a0b\u547d\u4ee4\u2026",
        @"Shortcuts: Run Shortcut..." : @"\u5feb\u6377\u6307\u4ee4\uff1a\u8fd0\u884c\u5feb\u6377\u6307\u4ee4\u2026",
        @"SneakyCam: Take Photo" : @"SneakyCam\uff1a\u62cd\u7167",
        @"SneakyCam: Toggle Video" : @"SneakyCam\uff1a\u5f55\u50cf\u5f00\u5173",

        @"SneakyCam Photo" : @"SneakyCam \u62cd\u7167",
        @"SneakyCam Video" : @"SneakyCam \u5f55\u50cf",
        @"Open Video Camera (2x, Flash)" : @"\u6253\u5f00\u89c6\u9891\u76f8\u673a\uff082x\uff0c\u95ea\u5149\uff09",
        @"Open Video Camera (2x)" : @"\u6253\u5f00\u89c6\u9891\u76f8\u673a\uff082x\uff09",
        @"Open Video Camera (1x, Flash)" : @"\u6253\u5f00\u89c6\u9891\u76f8\u673a\uff081x\uff0c\u95ea\u5149\uff09",
        @"Open Camera (Photo 0.5x)" : @"\u6253\u5f00\u76f8\u673a\uff08\u62cd\u7167 0.5x\uff09",
        @"Open Camera (Photo 2x)" : @"\u6253\u5f00\u76f8\u673a\uff08\u62cd\u7167 2x\uff09",
        @"Open Camera (Photo)" : @"\u6253\u5f00\u76f8\u673a\uff08\u62cd\u7167\uff09",
        @"Open Camera (Portrait 2x)" : @"\u6253\u5f00\u76f8\u673a\uff08\u4eba\u50cf 2x\uff09",
        @"Open Camera (Portrait)" : @"\u6253\u5f00\u76f8\u673a\uff08\u4eba\u50cf\uff09",
        @"Open Camera (Front Selfie)" : @"\u6253\u5f00\u76f8\u673a\uff08\u524d\u7f6e\u81ea\u62cd\uff09",
        @"Open Camera (Slo-Mo)" : @"\u6253\u5f00\u76f8\u673a\uff08\u6162\u52a8\u4f5c\uff09",
        @"Open Camera (Time-Lapse)" : @"\u6253\u5f00\u76f8\u673a\uff08\u5ef6\u65f6\u6444\u5f71\uff09",
        @"Open Camera (Cinematic)" : @"\u6253\u5f00\u76f8\u673a\uff08\u7535\u5f71\u6548\u679c\uff09",
        @"Open Camera (Pano)" : @"\u6253\u5f00\u76f8\u673a\uff08\u5168\u666f\uff09",
        @"Unlock Device (Saved Passcode)" : @"\u89e3\u9501\u8bbe\u5907\uff08\u5df2\u4fdd\u5b58\u5bc6\u7801\uff09",
        @"Lock Toggle (Saved Passcode)" : @"\u9501\u5b9a\u5f00\u5173\uff08\u5df2\u4fdd\u5b58\u5bc6\u7801\uff09",
        @"Disconnect Airplay" : @"\u65ad\u5f00 AirPlay",
        @"Play Haptics in Silent Mode" : @"\u9759\u97f3\u6a21\u5f0f\u89e6\u611f",
        @"Play Haptics in Ring Mode" : @"\u54cd\u94c3\u6a21\u5f0f\u89e6\u611f",
        @"Vibrate on Silent" : @"\u9759\u97f3\u65f6\u632f\u52a8",
        @"Vibrate on Ring" : @"\u54cd\u94c3\u65f6\u632f\u52a8",
        @"Pause Until Resumed" : @"\u6682\u505c\u81f3\u624b\u52a8\u6062\u590d",
        @"Noise Cancellation" : @"\u964d\u566a",
        @"Open Video Camera" : @"\u6253\u5f00\u89c6\u9891\u76f8\u673a",
        @"Open Camera" : @"\u6253\u5f00\u76f8\u673a",
        @"Front Selfie" : @"\u524d\u7f6e\u81ea\u62cd",
        @"Scan Again" : @"\u91cd\u65b0\u626b\u63cf",
        @"Available Outputs" : @"\u53ef\u7528\u8f93\u51fa",
        @"Paired Devices" : @"\u5df2\u914d\u5bf9\u8bbe\u5907",
        @"Only outputs reachable right now are listed." : @"\u53ea\u5217\u51fa\u5f53\u524d\u53ef\u8fde\u63a5\u7684\u8f93\u51fa\u3002",
        @"Matches any paired device whose name contains this text." : @"\u540d\u79f0\u5305\u542b\u6b64\u6587\u672c\u7684\u4efb\u610f\u5df2\u914d\u5bf9\u8bbe\u5907\u5747\u53ef\u5339\u914d\u3002",
        @"Volume Buttons" : @"\u97f3\u91cf\u952e",
        @"Power Button" : @"\u7535\u6e90\u952e",
        @"Screen Gestures" : @"\u5c4f\u5e55\u624b\u52bf",
        @"Edge Gestures" : @"\u8fb9\u7f18\u624b\u52bf",
        @"Bottom Bar Gestures" : @"\u5e95\u90e8\u6a2a\u6761\u624b\u52bf",
        @"Multi-Finger Gestures" : @"\u591a\u6307\u624b\u52bf",
        @"Apple Watch" : @"Apple Watch",
        @"Device State" : @"\u8bbe\u5907\u72b6\u6001",
        @"Motion Gestures" : @"\u52a8\u4f5c\u624b\u52bf",
        @"WiFi Network Triggers" : @"Wi-Fi \u7f51\u7edc\u89e6\u53d1\u5668",
        @"Bluetooth Device Triggers" : @"\u84dd\u7259\u8bbe\u5907\u89e6\u53d1\u5668",
        @"Audio Output Triggers" : @"\u97f3\u9891\u8f93\u51fa\u89e6\u53d1\u5668",
        @"Notification Triggers" : @"\u901a\u77e5\u89e6\u53d1\u5668",
        @"App Launch Triggers" : @"\u5e94\u7528\u542f\u52a8\u89e6\u53d1\u5668",
        @"App Exit Triggers" : @"\u5e94\u7528\u9000\u51fa\u89e6\u53d1\u5668",
        @"Scheduled Triggers" : @"\u5b9a\u65f6\u89e6\u53d1\u5668",
        @"MQTT Subscription Triggers" : @"MQTT \u8ba2\u9605\u89e6\u53d1\u5668",
        @"Other Triggers" : @"\u5176\u4ed6\u89e6\u53d1\u5668",
        @"Focus Modes" : @"\u4e13\u6ce8\u6a21\u5f0f",
        @"Runs when no Focus is left on." : @"\u6240\u6709\u4e13\u6ce8\u6a21\u5f0f\u90fd\u5173\u95ed\u65f6\u8fd0\u884c\u3002",
        @"Runs when any Focus turns on, including a switch from another." : @"\u4efb\u610f\u4e13\u6ce8\u6a21\u5f0f\u5f00\u542f\u65f6\u8fd0\u884c\uff08\u5305\u62ec\u5207\u6362\u5230\u53e6\u4e00\u4e13\u6ce8\u6a21\u5f0f\uff09\u3002",
        @"Focus On" : @"\u4e13\u6ce8\u6a21\u5f0f\u5f00\u542f",
        @"Tap the drawing to replay it. Numbers show the order of the touches; a ring is a tap." : @"\u70b9\u6309\u793a\u610f\u56fe\u53ef\u56de\u653e\u3002\u6570\u5b57\u8868\u793a\u89e6\u6478\u987a\u5e8f\uff1b\u5706\u73af\u8868\u793a\u70b9\u6309\u3002",
        @"Play on Phone" : @"\u5728\u672c\u673a\u64ad\u653e",
        @"Saved Gestures" : @"\u5df2\u5b58\u624b\u52bf",
        @"While recording, a red tab sits at the screen's edge. Pull it out to show Stop. Show Stop After brings Stop out by itself after a time without a touch. Stop on Touch stops a playing gesture when you touch the screen. Show Touches marks where a playing gesture touches." : @"\u5f55\u5236\u65f6\u5c4f\u5e55\u8fb9\u7f18\u6709\u4e00\u4e2a\u7ea2\u8272\u6807\u7b7e\uff0c\u62c9\u51fa\u5373\u53ef\u663e\u793a\u505c\u6b62\u6309\u94ae\u3002\u300c\u81ea\u52a8\u5f39\u51fa\u505c\u6b62\u6309\u94ae\u300d\u5728\u65e0\u89e6\u6478\u4e00\u6bb5\u65f6\u95f4\u540e\u81ea\u52a8\u5f39\u51fa\u3002\u89e6\u6478\u5373\u505c\u4f1a\u5728\u89e6\u78b0\u5c4f\u5e55\u65f6\u505c\u6b62\u624b\u52bf\u64ad\u653e\u3002\u663e\u793a\u89e6\u6478\u70b9\u4f1a\u6807\u8bb0\u624b\u52bf\u64ad\u653e\u65f6\u7684\u89e6\u6478\u4f4d\u7f6e\u3002",
        @"Recording starts after a short countdown. Use the phone as usual, then tap Stop. Touches play back with the same timing, so start from the screen the gesture begins on." : @"\u5f55\u5236\u5728\u77ed\u6682\u5012\u8ba1\u65f6\u540e\u5f00\u59cb\u3002\u6b63\u5e38\u4f7f\u7528\u624b\u673a\uff0c\u7136\u540e\u70b9\u505c\u6b62\u3002\u89e6\u6478\u6309\u539f\u65f6\u5e8f\u56de\u653e\uff0c\u8bf7\u4ece\u624b\u52bf\u5f00\u59cb\u7684\u90a3\u4e2a\u754c\u9762\u5f00\u59cb\u64cd\u4f5c\u3002",
        @"Clear All Gestures?" : @"\u6e05\u9664\u5168\u90e8\u624b\u52bf\uff1f",
        @"Clear Gesture?" : @"\u6e05\u9664\u624b\u52bf\uff1f",
        @"Actions that play it stop working." : @"\u64ad\u653e\u5b83\u7684\u52a8\u4f5c\u5c06\u5931\u6548\u3002",
        @"Actions that play them stop working." : @"\u64ad\u653e\u5b83\u4eec\u7684\u52a8\u4f5c\u5c06\u5931\u6548\u3002",
        @"The file couldn't be read." : @"\u6587\u4ef6\u65e0\u6cd5\u8bfb\u53d6\u3002",
        @"No gestures were found in the file." : @"\u6587\u4ef6\u4e2d\u672a\u627e\u5230\u624b\u52bf\u3002",
        @"Nothing Recorded" : @"\u672a\u5f55\u5236\u5185\u5bb9",
        @"No touches were recorded before Stop." : @"\u70b9\u505c\u6b62\u524d\u6ca1\u6709\u5f55\u5230\u4efb\u4f55\u89e6\u6478\u3002",
        @"The recording couldn't be saved." : @"\u5f55\u5236\u65e0\u6cd5\u4fdd\u5b58\u3002",
        @"The current recording is lost. Actions that play this gesture play the new one." : @"\u5f53\u524d\u5f55\u5236\u5c06\u4e22\u5931\u3002\u64ad\u653e\u6b64\u624b\u52bf\u7684\u52a8\u4f5c\u5c06\u64ad\u653e\u65b0\u5f55\u5236\u3002",
        @"Connection Details" : @"\u8fde\u63a5\u8be6\u60c5",
        @"Enable Home Assistant integration to trigger entity toggles, call services, and run scenes from triggers." : @"\u542f\u7528 Home Assistant \u96c6\u6210\u540e\u53ef\u7531\u89e6\u53d1\u5668\u63a7\u5236\u5b9e\u4f53\u3001\u8c03\u7528\u670d\u52a1\u548c\u8fd0\u884c\u573a\u666f\u3002",
        @"Specify your local or remote Home Assistant instance URL and a Long-Lived Access Token created in your HA profile." : @"\u586b\u5199\u672c\u5730\u6216\u8fdc\u7a0b Home Assistant \u5b9e\u4f8b URL\uff0c\u4ee5\u53ca\u5728 HA \u4e2a\u4eba\u8d44\u6599\u4e2d\u521b\u5efa\u7684\u957f\u671f\u8bbf\u95ee\u4ee4\u724c\u3002",
        @"Configure external service integrations to trigger actions and control third-party automations." : @"\u914d\u7f6e\u5916\u90e8\u670d\u52a1\u96c6\u6210\uff0c\u4ee5\u89e6\u53d1\u52a8\u4f5c\u5e76\u63a7\u5236\u7b2c\u4e09\u65b9\u81ea\u52a8\u5316\u3002",
        @"Authentication failed (check Web Server username/password)" : @"\u8ba4\u8bc1\u5931\u8d25\uff08\u68c0\u67e5 Web \u670d\u52a1\u5668\u7528\u6237\u540d/\u5bc6\u7801\uff09",
        @"Web Server Details" : @"Web \u670d\u52a1\u5668\u8be6\u60c5",
        @"Enable Keyboard Maestro integration to trigger macros on your Mac over Wi-Fi or LAN." : @"\u542f\u7528 Keyboard Maestro \u96c6\u6210\u540e\u53ef\u7ecf Wi-Fi \u6216\u5c40\u57df\u7f51\u89e6\u53d1 Mac \u4e0a\u7684\u5b8f\u3002",
        @"Configure the URL and authentication credentials specified in Keyboard Maestro Preferences > Web Server." : @"\u586b\u5199 Keyboard Maestro \u504f\u597d\u8bbe\u7f6e > Web \u670d\u52a1\u5668 \u4e2d\u6307\u5b9a\u7684 URL \u4e0e\u8ba4\u8bc1\u51ed\u636e\u3002",
        @"Host is empty" : @"\u4e3b\u673a\u4e3a\u7a7a",
        @"Connection rejected" : @"\u8fde\u63a5\u88ab\u62d2\u7edd",
        @"Unacceptable protocol version" : @"\u534f\u8bae\u7248\u672c\u4e0d\u53ef\u7528",
        @"Identifier rejected" : @"\u6807\u8bc6\u7b26\u88ab\u62d2\u7edd",
        @"Server unavailable" : @"\u670d\u52a1\u5668\u4e0d\u53ef\u7528",
        @"Bad username or password" : @"\u7528\u6237\u540d\u6216\u5bc6\u7801\u9519\u8bef",
        @"Not authorized" : @"\u672a\u6388\u6743",
        @"MQTT Error Code %d" : @"MQTT \u9519\u8bef\u7801 {0}",
        @"Failed to send CONNECT packet" : @"\u53d1\u9001 CONNECT \u5305\u5931\u8d25",
        @"Broker Details" : @"\u670d\u52a1\u5668\u8be6\u60c5",
        @"Enable MQTT integration to publish topics and trigger smart home or IoT automations directly." : @"\u542f\u7528 MQTT \u96c6\u6210\u540e\u53ef\u76f4\u63a5\u53d1\u5e03\u4e3b\u9898\uff0c\u89e6\u53d1\u667a\u80fd\u5bb6\u5c45\u6216 IoT \u81ea\u52a8\u5316\u3002",
        @"Configure your MQTT broker host, port, and optional credentials. Standard MQTT 3.1.1 protocol is used." : @"\u914d\u7f6e MQTT \u670d\u52a1\u5668\u7684\u4e3b\u673a\u3001\u7aef\u53e3\u4e0e\u53ef\u9009\u51ed\u636e\u3002\u4f7f\u7528\u6807\u51c6 MQTT 3.1.1 \u534f\u8bae\u3002",
        @"Edit MQTT Trigger" : @"\u7f16\u8f91 MQTT \u89e6\u53d1\u5668",
        @"New MQTT Trigger" : @"\u65b0\u5efa MQTT \u89e6\u53d1\u5668",
        @"Payload Match (Optional)" : @"\u8d1f\u8f7d\u5339\u914d\uff08\u53ef\u9009\uff09",
        @"Trigger Name (Optional)" : @"\u89e6\u53d1\u5668\u540d\u79f0\uff08\u53ef\u9009\uff09",
        @"Enter the topic to subscribe to. Supports exact topics or wildcards (+ for single level, # for multi-level)." : @"\u8f93\u5165\u8981\u8ba2\u9605\u7684\u4e3b\u9898\u3002\u652f\u6301\u7cbe\u786e\u4e3b\u9898\u6216\u901a\u914d\u7b26\uff08+ \u5339\u914d\u5355\u5c42\uff0c# \u5339\u914d\u591a\u5c42\uff09\u3002",
        @"Leave empty to trigger on any message received on this topic, or enter exact text/JSON payload to match." : @"\u7559\u7a7a\u5219\u6536\u5230\u8be5\u4e3b\u9898\u4efb\u4f55\u6d88\u606f\u90fd\u89e6\u53d1\uff1b\u4e5f\u53ef\u8f93\u5165\u7cbe\u786e\u6587\u672c/JSON \u8d1f\u8f7d\u8fdb\u884c\u5339\u914d\u3002",
        @"Hold nearest NFC tag to back of iPhone." : @"\u5c06\u6700\u8fd1\u7684 NFC \u6807\u7b7e\u8d34\u8fd1 iPhone \u80cc\u9762\u3002",
        @"Could not read Tag UID" : @"\u65e0\u6cd5\u8bfb\u53d6\u6807\u7b7e UID",
        @"Connection failed" : @"\u8fde\u63a5\u5931\u8d25",
        @"Tag does not support UID reading" : @"\u6807\u7b7e\u4e0d\u652f\u6301\u8bfb\u53d6 UID",
        @"Edit Notification" : @"\u7f16\u8f91\u901a\u77e5",
        @"New Notification" : @"\u65b0\u5efa\u901a\u77e5",
        @"Any App" : @"\u4efb\u610f\u5e94\u7528",
        @"Target App" : @"\u76ee\u6807\u5e94\u7528",
        @"Notification Bundle ID Override (Optional)" : @"\u901a\u77e5 Bundle ID \u8986\u76d6\uff08\u53ef\u9009\uff09",
        @"Text Match (Optional)" : @"\u6587\u672c\u5339\u914d\uff08\u53ef\u9009\uff09",
        @"Choose which app's notifications to listen for, or leave as 'Any App' to match all incoming notifications." : @"\u9009\u62e9\u8981\u76d1\u542c\u54ea\u4e2a\u5e94\u7528\u7684\u901a\u77e5\uff1b\u4fdd\u6301\u300c\u4efb\u610f\u5e94\u7528\u300d\u53ef\u5339\u914d\u6240\u6709\u5230\u6765\u7684\u901a\u77e5\u3002",
        @"Manually specify a custom notification bundle ID if iOS delivers notifications under a different identifier (e.g. com.apple.ShazamNotifications)." : @"\u82e5 iOS \u7528\u5176\u4ed6\u6807\u8bc6\u7b26\u6295\u9012\u901a\u77e5\uff08\u5982 com.apple.ShazamNotifications\uff09\uff0c\u53ef\u624b\u52a8\u6307\u5b9a\u81ea\u5b9a\u4e49\u901a\u77e5 Bundle ID\u3002",
        @"Matches text in the title, subtitle, or body (case-insensitive)." : @"\u5339\u914d\u6807\u9898\u3001\u526f\u6807\u9898\u6216\u6b63\u6587\u4e2d\u7684\u6587\u672c\uff08\u4e0d\u533a\u5206\u5927\u5c0f\u5199\uff09\u3002",
        @"Any Notification" : @"\u4efb\u610f\u901a\u77e5",
        @"Repeat Round only has a value inside a Repeat." : @"\u91cd\u590d\u8f6e\u6b21\u4ec5\u5728\u91cd\u590d\u4ee3\u7801\u5757\u5185\u6709\u503c\u3002",
        @"Variable names use letters, digits and _ only." : @"\u53d8\u91cf\u540d\u53ea\u80fd\u7528\u5b57\u6bcd\u3001\u6570\u5b57\u548c _\u3002",
        @"Play Gesture" : @"\u64ad\u653e\u624b\u52bf",
        @"Playback Speed" : @"\u64ad\u653e\u901f\u5ea6",
        @"Record and manage gestures in Settings > Gestures." : @"\u5728 \u8bbe\u7f6e > \u624b\u52bf \u4e2d\u5f55\u5236\u548c\u7ba1\u7406\u624b\u52bf\u3002",
        @"Faster or slower playback can change flicks and long presses." : @"\u52a0\u5feb\u6216\u653e\u6162\u64ad\u653e\u53ef\u80fd\u6539\u53d8\u5feb\u6ed1\u4e0e\u957f\u6309\u7684\u5224\u5b9a\u3002",
        @"Stopped at the 1,000-round limit" : @"\u5df2\u5230 1000 \u8f6e\u4e0a\u9650\u505c\u6b62",
        @"Left the loop" : @"\u5df2\u79bb\u5f00\u5faa\u73af",
        @"Time limit reached" : @"\u5230\u8fbe\u65f6\u95f4\u4e0a\u9650",
        @"Stopped here" : @"\u5728\u6b64\u505c\u6b62",
        @"Run History is off. Turn it on with Keep in the \u2022\u2022\u2022 menu." : @"\u8fd0\u884c\u5386\u53f2\u5df2\u5173\u95ed\u3002\u5728 \u2022\u2022\u2022 \u83dc\u5355\u4e2d\u6253\u5f00\u300c\u4fdd\u7559\u300d\u4ee5\u542f\u7528\u3002",
        @"Stop ends that run of the trigger, even during a wait or a loop; Stop All ends every run. Tap a run to follow it, with the action it's on highlighted." : @"\u300c\u505c\u6b62\u300d\u7ed3\u675f\u8be5\u89e6\u53d1\u5668\u7684\u90a3\u6b21\u8fd0\u884c\uff08\u5305\u62ec\u7b49\u5f85\u548c\u5faa\u73af\u4e2d\uff09\uff1b\u300c\u5168\u90e8\u505c\u6b62\u300d\u7ed3\u675f\u6240\u6709\u8fd0\u884c\u3002\u70b9\u67d0\u6b21\u8fd0\u884c\u53ef\u8ddf\u8e2a\u5176\u8fdb\u5ea6\uff0c\u5f53\u524d\u52a8\u4f5c\u4f1a\u9ad8\u4eae\u3002",
        @"Edit SSH Command" : @"\u7f16\u8f91 SSH \u547d\u4ee4",
        @"New SSH Command" : @"\u65b0\u5efa SSH \u547d\u4ee4",
        @"Pick the server this command runs on. Manage servers in Settings > Integrations > SSH Hosts." : @"\u9009\u62e9\u8fd0\u884c\u6b64\u547d\u4ee4\u7684\u670d\u52a1\u5668\u3002\u5728 \u8bbe\u7f6e > \u96c6\u6210 > SSH \u4e3b\u673a \u4e2d\u7ba1\u7406\u670d\u52a1\u5668\u3002",
        @"Runs on the remote machine, exactly as typed. Multiple lines are allowed." : @"\u5728\u8fdc\u7a0b\u673a\u5668\u4e0a\u6309\u8f93\u5165\u539f\u6837\u6267\u884c\uff0c\u5141\u8bb8\u591a\u884c\u3002",
        @"Edit SSH Host" : @"\u7f16\u8f91 SSH \u4e3b\u673a",
        @"New SSH Host" : @"\u65b0\u5efa SSH \u4e3b\u673a",
        @"Leave blank to keep" : @"\u7559\u7a7a\u4fdd\u6301\u4e0d\u53d8",
        @"Private Key" : @"\u79c1\u94a5",
        @"Host Required" : @"\u5fc5\u987b\u586b\u5199\u4e3b\u673a",
        @"Enter a hostname or IP address." : @"\u8f93\u5165\u4e3b\u673a\u540d\u6216 IP \u5730\u5740\u3002",
        @"Invalid Host" : @"\u4e3b\u673a\u65e0\u6548",
        @"Hostname may not start with - or contain spaces." : @"\u4e3b\u673a\u540d\u4e0d\u80fd\u4ee5 - \u5f00\u5934\u6216\u5305\u542b\u7a7a\u683c\u3002",
        @"Invalid Username" : @"\u7528\u6237\u540d\u65e0\u6548",
        @"Username may not start with - or contain spaces." : @"\u7528\u6237\u540d\u4e0d\u80fd\u4ee5 - \u5f00\u5934\u6216\u5305\u542b\u7a7a\u683c\u3002",
        @"Key Path Required" : @"\u5fc5\u987b\u586b\u5199\u5bc6\u94a5\u8def\u5f84",
        @"Enter the path to the private key, e.g. ~/.ssh/id_rsa." : @"\u8f93\u5165\u79c1\u94a5\u8def\u5f84\uff0c\u4f8b\u5982 ~/.ssh/id_rsa\u3002",
        @"The key file must already exist on this iPhone. A path starting with ~ expands to the home directory." : @"\u5bc6\u94a5\u6587\u4ef6\u5fc5\u987b\u5df2\u5b58\u5728\u4e8e\u672c\u673a\u3002\u4ee5 ~ \u5f00\u5934\u7684\u8def\u5f84\u4f1a\u5c55\u5f00\u4e3a\u7528\u6237\u4e3b\u76ee\u5f55\u3002",
        @"The saved password is never shown. Leave the field blank to keep it, or type a new one to replace it." : @"\u5df2\u4fdd\u5b58\u7684\u5bc6\u7801\u4e0d\u4f1a\u663e\u793a\u3002\u7559\u7a7a\u4fdd\u6301\u4e0d\u53d8\uff0c\u8f93\u5165\u65b0\u5bc6\u7801\u5219\u66ff\u6362\u3002",
        @"Saved passwords are never shown once stored. Leave empty for key-agent logins." : @"\u5df2\u4fdd\u5b58\u7684\u5bc6\u7801\u4e0d\u4f1a\u518d\u6b21\u663e\u793a\u3002\u7559\u7a7a\u5219\u4f7f\u7528\u5bc6\u94a5\u4ee3\u7406\u767b\u5f55\u3002",
        @"Key Path" : @"\u5bc6\u94a5\u8def\u5f84",
        @"Configured Hosts" : @"\u5df2\u914d\u7f6e\u4e3b\u673a",
        @"Edit Schedule" : @"\u7f16\u8f91\u5b9a\u65f6",
        @"New Schedule" : @"\u65b0\u5efa\u5b9a\u65f6",
        @"Execution Time" : @"\u6267\u884c\u65f6\u95f4",
        @"Repeat Days" : @"\u91cd\u590d\u65e5\u671f",
        @"Failed to create UNIX socket" : @"\u521b\u5efa UNIX \u5957\u63a5\u5b57\u5931\u8d25",
        @"Could not connect to RemoteCompanion tweak (UNIX socket)" : @"\u65e0\u6cd5\u8fde\u63a5 RemoteCompanion \u63d2\u4ef6\uff08UNIX \u5957\u63a5\u5b57\uff09",
        @"Failed to send command" : @"\u53d1\u9001\u547d\u4ee4\u5931\u8d25",
        @"Text or Number" : @"\u6587\u672c\u6216\u6570\u5b57",
        @"Stores this text or number, replacing the current value. {name} inserts another variable's value; {round} inserts the repeat round." : @"\u4fdd\u5b58\u6b64\u6587\u672c\u6216\u6570\u5b57\u5e76\u66ff\u6362\u5f53\u524d\u503c\u3002{name} \u63d2\u5165\u5176\u4ed6\u53d8\u91cf\u7684\u503c\uff1b{round} \u63d2\u5165\u91cd\u590d\u8f6e\u6b21\u3002",
        @"Random Number" : @"\u968f\u673a\u6570",
        @"Stores a random whole number from From to To, both included. Each can be a number or a {variable}." : @"\u4fdd\u5b58\u4e00\u4e2a\u4ece\u300c\u4ece\u300d\u5230\u300c\u5230\u300d\u7684\u968f\u673a\u6574\u6570\uff08\u542b\u4e24\u7aef\uff09\u3002\u4e24\u7aef\u5747\u53ef\u4e3a\u6570\u5b57\u6216 {variable}\u3002",
        @"Runs an RC command and stores its answer. For example, wifi status stores \"WiFi ON\"." : @"\u8fd0\u884c RC \u547d\u4ee4\u5e76\u4fdd\u5b58\u5176\u5e94\u7b54\u3002\u4f8b\u5982 wifi status \u4f1a\u4fdd\u5b58\u300cWiFi ON\u300d\u3002",
        @"Runs an RC command and stores the first number in its answer. For example, volume answers \"Volume: 100%\" and stores 100." : @"\u8fd0\u884c RC \u547d\u4ee4\u5e76\u4fdd\u5b58\u5e94\u7b54\u4e2d\u7684\u7b2c\u4e00\u4e2a\u6570\u5b57\u3002\u4f8b\u5982 volume \u5e94\u7b54\u300cVolume: 100%\u300d\u5219\u4fdd\u5b58 100\u3002",
        @"Adds the amount to the variable. A variable without a value starts at 0, so Add 1 works as a counter." : @"\u5c06\u6570\u503c\u52a0\u5230\u53d8\u91cf\u4e0a\u3002\u65e0\u503c\u53d8\u91cf\u4ece 0 \u5f00\u59cb\uff0c\u56e0\u6b64\u52a0 1 \u53ef\u5f53\u8ba1\u6570\u5668\u7528\u3002",
        @"Subtracts the amount from the variable. A variable without a value starts at 0." : @"\u4ece\u53d8\u91cf\u4e2d\u51cf\u53bb\u6570\u503c\u3002\u65e0\u503c\u53d8\u91cf\u4ece 0 \u5f00\u59cb\u3002",
        @"Multiplies the variable by this number." : @"\u5c06\u53d8\u91cf\u4e58\u4ee5\u6b64\u6570\u503c\u3002",
        @"Divides the variable by this number. Dividing by 0 leaves it unchanged." : @"\u5c06\u53d8\u91cf\u9664\u4ee5\u6b64\u6570\u503c\u3002\u9664\u4ee5 0 \u5219\u4fdd\u6301\u4e0d\u53d8\u3002",
        @"Rounds the variable to this many decimal places; empty rounds to a whole number. For example, 2 turns 3.14159 into 3.14." : @"\u5c06\u53d8\u91cf\u56db\u820d\u4e94\u5165\u5230\u6307\u5b9a\u5c0f\u6570\u4f4d\uff1b\u7559\u7a7a\u5219\u53d6\u6574\u3002\u4f8b\u5982 2 \u4f1a\u628a 3.14159 \u53d8\u6210 3.14\u3002",
        @"The current pass of a Repeat: 1, 2, 3\u2026" : @"\u91cd\u590d\u7684\u5f53\u524d\u8f6e\u6b21\uff1a1\u30012\u30013\u2026",
        @"Set Variable" : @"\u8bbe\u7f6e\u53d8\u91cf",
        @"Choose Command" : @"\u9009\u62e9\u547d\u4ee4",
        @"Choose the variable to change. Its value must be a number; otherwise it stays unchanged and Run History shows why." : @"\u9009\u62e9\u8981\u66f4\u6539\u7684\u53d8\u91cf\u3002\u5176\u503c\u5fc5\u987b\u662f\u6570\u5b57\uff0c\u5426\u5219\u4fdd\u6301\u4e0d\u53d8\uff0c\u539f\u56e0\u4f1a\u663e\u793a\u5728\u8fd0\u884c\u5386\u53f2\u4e2d\u3002",
        @"Changes the value this run set. It is forgotten when the run ends." : @"\u66f4\u6539\u672c\u6b21\u8fd0\u884c\u8bbe\u7f6e\u7684\u503c\u3002\u8fd0\u884c\u7ed3\u675f\u540e\u5373\u5931\u6548\u3002",
        @"Changes the saved value, which every trigger can use." : @"\u66f4\u6539\u4fdd\u5b58\u7684\u503c\uff0c\u6240\u6709\u89e6\u53d1\u5668\u90fd\u53ef\u4f7f\u7528\u3002",
        @"Set Value" : @"\u8bbe\u7f6e\u503c",
        @"Change Value" : @"\u66f4\u6539\u503c",
        @"Number Only" : @"\u4ec5\u6570\u5b57",
        @"This Run Only" : @"\u4ec5\u672c\u6b21\u8fd0\u884c",
        @"Enable the built-in Web UI to configure RemoteCompanion from a browser." : @"\u542f\u7528\u5185\u7f6e Web UI\uff0c\u53ef\u4ece\u6d4f\u89c8\u5668\u914d\u7f6e RemoteCompanion\u3002",
        @"Configure connections to external services and automations." : @"\u914d\u7f6e\u5916\u90e8\u670d\u52a1\u4e0e\u81ea\u52a8\u5316\u7684\u8fde\u63a5\u3002",
        @"NFC, banners, logging, and display options, and the variables that Set Variable actions save." : @"NFC\u3001\u6a2a\u5e45\u3001\u65e5\u5fd7\u4e0e\u663e\u793a\u9009\u9879\uff0c\u4ee5\u53ca\u300c\u8bbe\u7f6e\u53d8\u91cf\u300d\u52a8\u4f5c\u4fdd\u5b58\u7684\u53d8\u91cf\u3002",
        @"Recorded gestures and the recording tab's options." : @"\u5df2\u5f55\u5236\u7684\u624b\u52bf\u4e0e\u5f55\u5236\u6807\u7b7e\u7684\u9009\u9879\u3002",
        @"See what's running on this device, and run tests that share their results." : @"\u67e5\u770b\u672c\u673a\u6b63\u5728\u8fd0\u884c\u7684\u5185\u5bb9\uff0c\u5e76\u8fd0\u884c\u53ef\u5206\u4eab\u7ed3\u679c\u7684\u6d4b\u8bd5\u3002",
        @"Export your configuration to share or backup. Import to restore." : @"\u5bfc\u51fa\u914d\u7f6e\u7528\u4e8e\u5206\u4eab\u6216\u5907\u4efd\u3002\u5bfc\u5165\u53ef\u6062\u590d\u3002",
        @"No list from RemoteCompanion" : @"RemoteCompanion \u672a\u8fd4\u56de\u5217\u8868",
        @"Testing Method" : @"\u6d4b\u8bd5\u65b9\u5f0f",
        @"Steps the phone can't do by itself. They run first, so the phone can be left alone for the rest." : @"\u624b\u673a\u65e0\u6cd5\u81ea\u884c\u5b8c\u6210\u7684\u6b65\u9aa4\u3002\u8fd9\u4e9b\u6b65\u9aa4\u5148\u8fd0\u884c\uff0c\u4e4b\u540e\u5373\u53ef\u653e\u7740\u4e0d\u7ba1\u3002",
        @"Your triggers are swapped for test ones (their actions don't run) and put back after." : @"\u4f60\u7684\u89e6\u53d1\u5668\u4f1a\u88ab\u6362\u6210\u6d4b\u8bd5\u89e6\u53d1\u5668\uff08\u5176\u52a8\u4f5c\u4e0d\u8fd0\u884c\uff09\uff0c\u7ed3\u675f\u540e\u6062\u590d\u539f\u6837\u3002",
        @"To begin, go to the home screen and press Volume Up." : @"\u5f00\u59cb\u524d\u8bf7\u56de\u5230\u4e3b\u5c4f\u5e55\u5e76\u6309\u97f3\u91cf\u52a0\u3002",
        @"Button presses are tested in Button Triggers." : @"\u6309\u952e\u6d4b\u8bd5\u5728\u6309\u952e\u89e6\u53d1\u5668\u9875\u8fdb\u884c\u3002",
        @"Each press is done twice: with the tweak off, then on. iOS responds to every press as it would to a real one." : @"\u6bcf\u6b21\u6309\u538b\u6d4b\u4e24\u904d\uff1a\u5148\u5173\u63d2\u4ef6\u518d\u5f00\u63d2\u4ef6\u3002iOS \u5bf9\u6bcf\u6b21\u6309\u538b\u90fd\u4f1a\u50cf\u771f\u5b9e\u6309\u538b\u4e00\u6837\u54cd\u5e94\u3002",
        @"If Conditions" : @"\u5982\u679c\u6761\u4ef6",
        @"Toggle Actions" : @"\u5f00\u5173\u7c7b\u52a8\u4f5c",
        @"Stock vs Tweak" : @"\u539f\u751f\u4e0e\u63d2\u4ef6\u5bf9\u6bd4",
        @"Checks each If condition against the phone's current state." : @"\u7528\u624b\u673a\u5f53\u524d\u72b6\u6001\u9010\u4e00\u68c0\u67e5\u5982\u679c\u6761\u4ef6\u3002",
        @"Switches each toggle action and reads it back, then restores everything." : @"\u9010\u4e00\u5207\u6362\u5f00\u5173\u52a8\u4f5c\u5e76\u56de\u8bfb\u72b6\u6001\uff0c\u6700\u540e\u5168\u90e8\u6062\u590d\u3002",
        @"Checks that each gesture and sensor trigger fires once." : @"\u68c0\u67e5\u6bcf\u4e2a\u624b\u52bf\u4e0e\u4f20\u611f\u5668\u89e6\u53d1\u5668\u662f\u5426\u5404\u89e6\u53d1\u4e00\u6b21\u3002",
        @"Compares each button press with the tweak off and on." : @"\u5bf9\u6bd4\u6bcf\u4e2a\u6309\u952e\u5728\u63d2\u4ef6\u5173\u95ed\u4e0e\u5f00\u542f\u65f6\u7684\u8868\u73b0\u3002",
        @"Checks that each button trigger fires once, with the presses done by the tweak." : @"\u68c0\u67e5\u6bcf\u4e2a\u6309\u952e\u89e6\u53d1\u5668\u662f\u5426\u5404\u89e6\u53d1\u4e00\u6b21\uff0c\u6309\u538b\u7531\u63d2\u4ef6\u5b8c\u6210\u3002",
        @"A Test Is Running" : @"\u6d4b\u8bd5\u6b63\u5728\u8fd0\u884c",
        @"Stop it first, or wait for it to finish." : @"\u8bf7\u5148\u505c\u6b62\uff0c\u6216\u7b49\u5b83\u7ed3\u675f\u3002",
        @"Each toggle is switched and put back afterwards. Toggles that drop connections for a moment are left out unless you include them." : @"\u6bcf\u4e2a\u5f00\u5173\u90fd\u4f1a\u5207\u6362\u5e76\u5728\u7ed3\u675f\u540e\u590d\u539f\u3002\u4f1a\u77ed\u6682\u65ad\u5f00\u8fde\u63a5\u7684\u5f00\u5173\u9ed8\u8ba4\u4e0d\u6d4b\uff0c\u9664\u975e\u624b\u52a8\u52fe\u9009\u3002",
        @"Not set" : @"\u672a\u8bbe\u7f6e",
        @"Forgotten in 1 minute" : @"1 \u5206\u949f\u540e\u6e05\u9664",
        @"Lets test runs unlock the phone between steps. It stays on this phone only (in its Keychain, never in a backup), and is forgotten after 30 minutes, a restart, or if it doesn't unlock the phone." : @"\u5141\u8bb8\u6d4b\u8bd5\u6b65\u9aa4\u95f4\u89e3\u9501\u624b\u673a\u3002\u5bc6\u7801\u53ea\u5b58\u4e8e\u672c\u673a\u94a5\u5319\u4e32\uff08\u7edd\u4e0d\u8fdb\u5907\u4efd\uff09\uff0c30 \u5206\u949f\u540e\u3001\u91cd\u542f\u540e\u6216\u89e3\u9501\u5931\u8d25\u65f6\u81ea\u52a8\u6e05\u9664\u3002",
        @"Your settings are put back when a test ends." : @"\u6d4b\u8bd5\u7ed3\u675f\u540e\u4f1a\u6062\u590d\u4f60\u7684\u8bbe\u7f6e\u3002",
        @"Reports of finished tests appear here." : @"\u5b8c\u6210\u7684\u6d4b\u8bd5\u62a5\u544a\u4f1a\u663e\u793a\u5728\u8fd9\u91cc\u3002",
        @"Waiting to start: go to the home screen and press Volume Up." : @"\u7b49\u5f85\u5f00\u59cb\uff1a\u56de\u5230\u4e3b\u5c4f\u5e55\u5e76\u6309\u97f3\u91cf\u52a0\u3002",
        @"True for that one minute." : @"\u4ec5\u90a3\u4e00\u5206\u949f\u5185\u6210\u7acb\u3002",
        @"True from the start time, past midnight, until the end time." : @"\u4ece\u5f00\u59cb\u65f6\u95f4\u8de8\u8fc7\u5348\u591c\u76f4\u5230\u7ed3\u675f\u65f6\u95f4\u6210\u7acb\u3002",
        @"True from the start time until the end time." : @"\u4ece\u5f00\u59cb\u65f6\u95f4\u5230\u7ed3\u675f\u65f6\u95f4\u6210\u7acb\u3002",
        @"Status Bar" : @"\u72b6\u6001\u680f",
        @"App Triggers" : @"\u5e94\u7528\u89e6\u53d1\u5668",
        @"Long press to run it now" : @"\u957f\u6309\u7acb\u5373\u8fd0\u884c",
        @"Button triggers paused" : @"\u6309\u952e\u89e6\u53d1\u5668\u5df2\u6682\u505c",
        @"Button triggers paused by another tweak" : @"\u6309\u952e\u89e6\u53d1\u5668\u88ab\u5176\u4ed6\u63d2\u4ef6\u6682\u505c",
        @"Audio Output" : @"\u97f3\u9891\u8f93\u51fa",
        @"App Exit" : @"\u5e94\u7528\u9000\u51fa",
        @"Its actions are deleted too." : @"\u5176\u52a8\u4f5c\u4e5f\u4f1a\u88ab\u5220\u9664\u3002",
        @"Main BG" : @"\u4e3b\u80cc\u666f",
        @"Settings BG" : @"\u8bbe\u7f6e\u80cc\u666f",
        @"Select Actions BG" : @"\u9009\u62e9\u52a8\u4f5c\u80cc\u666f",
        @"Block BG" : @"\u4ee3\u7801\u5757\u80cc\u666f",
        @"Nav Bar BG" : @"\u5bfc\u822a\u680f\u80cc\u666f",
        @"Selection Highlight" : @"\u9009\u62e9\u9ad8\u4eae",
        @"Current UI Color Tweaks:\\n" : @"\u5f53\u524d UI \u989c\u8272\u8c03\u6574\uff1a\\n",
        @"True when the variable equals this text or number. Letter case doesn't matter." : @"\u53d8\u91cf\u7b49\u4e8e\u6b64\u6587\u672c\u6216\u6570\u5b57\u65f6\u6210\u7acb\uff08\u4e0d\u533a\u5206\u5927\u5c0f\u5199\uff09\u3002",
        @"Is Not" : @"\u4e0d\u7b49\u4e8e",
        @"True when the variable doesn't equal this text or number. Letter case doesn't matter." : @"\u53d8\u91cf\u4e0d\u7b49\u4e8e\u6b64\u6587\u672c\u6216\u6570\u5b57\u65f6\u6210\u7acb\uff08\u4e0d\u533a\u5206\u5927\u5c0f\u5199\uff09\u3002",
        @"True when this text appears anywhere in the variable. Letter case doesn't matter." : @"\u6b64\u6587\u672c\u51fa\u73b0\u5728\u53d8\u91cf\u4e2d\u4efb\u610f\u4f4d\u7f6e\u65f6\u6210\u7acb\uff08\u4e0d\u533a\u5206\u5927\u5c0f\u5199\uff09\u3002",
        @"Is Above" : @"\u9ad8\u4e8e",
        @"True when the variable is a number greater than this one." : @"\u53d8\u91cf\u662f\u5927\u4e8e\u6b64\u503c\u7684\u6570\u5b57\u65f6\u6210\u7acb\u3002",
        @"Is Below" : @"\u4f4e\u4e8e",
        @"True when the variable is a number less than this one." : @"\u53d8\u91cf\u662f\u5c0f\u4e8e\u6b64\u503c\u7684\u6570\u5b57\u65f6\u6210\u7acb\u3002",
        @"Has Value" : @"\u6709\u503c",
        @"Has Any Value" : @"\u6709\u4efb\u610f\u503c",
        @"True when the variable has any value." : @"\u53d8\u91cf\u6709\u4efb\u610f\u503c\u65f6\u6210\u7acb\u3002",
        @"No Value" : @"\u65e0\u503c",
        @"Has No Value" : @"\u65e0\u4efb\u4f55\u503c",
        @"True when the variable has no value or was never set." : @"\u53d8\u91cf\u65e0\u503c\u6216\u4ece\u672a\u8bbe\u7f6e\u65f6\u6210\u7acb\u3002",
        @"The variable to check." : @"\u8981\u68c0\u67e5\u7684\u53d8\u91cf\u3002",
        @"Use letters, digits and _, without spaces, not starting with a digit. \"round\" is reserved." : @"\u7528\u5b57\u6bcd\u3001\u6570\u5b57\u548c _\uff0c\u65e0\u7a7a\u683c\uff0c\u4e0d\u80fd\u4ee5\u6570\u5b57\u5f00\u5934\u3002\u300cround\u300d\u4e3a\u4fdd\u7559\u5b57\u3002",
        @"Set Variable actions save variables here, for all triggers. In an action's text, {name} becomes the value. Tap one to change it; swipe to delete." : @"\u300c\u8bbe\u7f6e\u53d8\u91cf\u300d\u52a8\u4f5c\u628a\u53d8\u91cf\u4fdd\u5b58\u5728\u8fd9\u91cc\uff0c\u4f9b\u6240\u6709\u89e6\u53d1\u5668\u4f7f\u7528\u3002\u52a8\u4f5c\u6587\u672c\u4e2d {name} \u4f1a\u66ff\u6362\u4e3a\u503c\u3002\u70b9\u6309\u53ef\u4fee\u6539\uff0c\u4fa7\u6ed1\u53ef\u5220\u9664\u3002",
        @"Any Network" : @"\u4efb\u610f\u7f51\u7edc",
        @"Trusted Networks" : @"\u53d7\u4fe1\u4efb\u7f51\u7edc",
        @"This iPhone Only" : @"\u4ec5\u672c\u673a",
        @"Protects raw shell and root commands from unauthenticated local network callers." : @"\u4fdd\u62a4\u539f\u751f shell \u4e0e root \u547d\u4ee4\u4e0d\u88ab\u672a\u8ba4\u8bc1\u7684\u5c40\u57df\u7f51\u8c03\u7528\u3002",
        @"Anyone can name a network the same as a trusted one, so add only private networks." : @"\u4efb\u4f55\u4eba\u90fd\u80fd\u628a\u7f51\u7edc\u547d\u540d\u6210\u4e0e\u53d7\u4fe1\u4efb\u7f51\u7edc\u76f8\u540c\u7684\u540d\u5b57\uff0c\u56e0\u6b64\u53ea\u6dfb\u52a0\u79c1\u6709\u7f51\u7edc\u3002",
        @"The Web UI can be reached only while this iPhone is on a trusted Wi-Fi network. This iPhone can always reach it." : @"\u4ec5\u5f53\u672c\u673a\u8fde\u63a5\u53d7\u4fe1\u4efb Wi-Fi \u7f51\u7edc\u65f6\u53ef\u8bbf\u95ee Web UI\u3002\u672c\u673a\u59cb\u7ec8\u53ef\u4ee5\u8bbf\u95ee\u3002",
        @"The Web UI can be reached only from this iPhone, at localhost." : @"Web UI \u4ec5\u53ef\u4ece\u672c\u673a\uff08localhost\uff09\u8bbf\u95ee\u3002",
        @"The Web UI can be reached from any device on the same network as this iPhone." : @"\u4e0e\u672c\u673a\u540c\u7f51\u7edc\u7684\u4efb\u4f55\u8bbe\u5907\u90fd\u53ef\u8bbf\u95ee Web UI\u3002",
        @"Edit WiFi Trigger" : @"\u7f16\u8f91 Wi-Fi \u89e6\u53d1\u5668",

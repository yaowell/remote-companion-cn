        @"Bottom Bar Swipe Left" : @"\u5e95\u90e8\u6a2a\u6761\u5de6\u6ed1",
        @"Bottom Bar Swipe Right" : @"\u5e95\u90e8\u6a2a\u6761\u53f3\u6ed1",
